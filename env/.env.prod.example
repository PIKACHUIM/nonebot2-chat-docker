# ===========================================================================
# MyQQBot 生产配置模板
#
#   cp env/.env.prod.example env/.env.prod   然后填写真实值
#
# 由 docker-compose.yml 的 env_file 注入为容器环境变量。
# env/.env.prod 已被 .gitignore 忽略，真实密钥不会被提交。
#
# 格式要求（很关键）：
#   1) 每行只能是 KEY=VALUE 单行；不支持多行续行、不支持行尾注释。
#   2) 值不要加引号，Compose 对引号的处理与 python-dotenv 不完全一致。
#   3) QQ_BOTS 的 JSON 必须压成一行（下面已压好，改的时候别换行）。
# ===========================================================================

# ---------------------------------------------------------------------------
# QQ 官方机器人
#   AppID / AppSecret 来自 QQ 开放平台 -> 机器人 -> 开发设置
#   意图：c2c_group_at_messages（群与私聊 @ 消息）需要平台侧同时开通
#   可选：group_members、guild_messages、direct_message
# ---------------------------------------------------------------------------
QQ_BOTS=[{"id":"YOUR_APP_ID","secret":"YOUR_APP_SECRET","intent":{"c2c_group_at_messages":true,"group_members":true},"use_websocket":true}]

# ---------------------------------------------------------------------------
# Agent 模型（任意 OpenAI 兼容端点）
#   示例：
#     OpenAI        AGENT_BASE_URL=https://api.openai.com/v1
#     DeepSeek      AGENT_BASE_URL=https://api.deepseek.com/v1
#     自建/中转      AGENT_BASE_URL=https://your-endpoint/v1
# ---------------------------------------------------------------------------
AGENT_MODEL=YOUR_MODEL_NAME
AGENT_BASE_URL=https://your-openai-compatible-endpoint/v1
AGENT_API_KEY=YOUR_API_KEY

# 可选：透传给模型的 reasoning_effort，常用 low / medium / high。
# 供应商不支持时留空。
AGENT_REASONING_EFFORT=medium

# 可选：开启 Agent 的联网搜索（chat / reserved 模式下的 WebSearch）
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# 访问白名单（关键：全部留空 = 谁都不能用）
#   群：填 group_openid
#   私聊：填对方 user_id（openid）
#   管理员：填 user_id，逗号分隔；只有管理员能执行 /mode /reset 等改状态的指令
#   不知道 ID 就先只填一个管理员，发条消息，从日志里抄 event 的 openid
# ---------------------------------------------------------------------------
BRIDGE_MODE=chat
BRIDGE_OWNER_IDS=
BRIDGE_ALLOWED_GROUPS=
BRIDGE_ALLOWED_PRIVATE=

# ---------------------------------------------------------------------------
# 会话行为
# ---------------------------------------------------------------------------
BRIDGE_MAX_MESSAGE_CHARS=500
# 单个会话每滚动 60 秒最多发几条（文本/工具/审批/语音共用额度），1~60
BRIDGE_MAX_MESSAGES_PER_MINUTE=6
BRIDGE_MAX_MEDIA_BYTES=8388608

# 控制台令牌。留空则自动生成到 BRIDGE_STATE_DIR/console-token
# 对外暴露控制台时务必设成一段长随机串
BRIDGE_CONSOLE_TOKEN=

# ---------------------------------------------------------------------------
# 语音（pyttsx3 + espeak-ng，镜像内已装好）
# ---------------------------------------------------------------------------
BRIDGE_VOICE_MAX_BYTES=20971520
BRIDGE_VOICE_MAX_TEXT_CHARS=500
BRIDGE_VOICE_RATE=175
BRIDGE_VOICE_VOLUME=1.0
# 留空用默认音色；中文可试 zh / cmn
BRIDGE_VOICE_ID=
BRIDGE_VOICE_SENDS_PER_HOUR=20

# ---------------------------------------------------------------------------
# 群黑话提取
# ---------------------------------------------------------------------------
BRIDGE_SLANG_ENABLED=true
BRIDGE_SLANG_MIN_MESSAGES=10
BRIDGE_SLANG_COOLDOWN_SECONDS=300

# ---------------------------------------------------------------------------
# 用量成本估算（控制台里显示预估费用，按每百万 token 计价，填 0 则不估算）
# ---------------------------------------------------------------------------
BRIDGE_INPUT_COST_PER_MILLION=0
BRIDGE_OUTPUT_COST_PER_MILLION=0

# ---------------------------------------------------------------------------
# 注意：AGENT_WORKSPACE / BRIDGE_STATE_DIR / BRIDGE_VOICE_DIR 不在这里配，
# 统一由 docker-compose.yml 的 environment 指向容器内 /data 路径。
# ---------------------------------------------------------------------------
