# ---------------------------------------------------------------------------
# Compose 层变量：只控制「怎么跑容器」，不涉及机器人业务配置。
# 使用前：cp .env.example .env
# ---------------------------------------------------------------------------

# 镜像标签，改这个再 up 可以区分版本
IMAGE_TAG=latest

# 基础镜像 Python 版本（plugin-chatbot 要求 >=3.10,<4.0）
PYTHON_VERSION=3.12

# plugin-chatbot 的 git commit。插件没有 PyPI 包，只能钉 commit 保证可复现。
# 升级插件：改这里 -> docker compose build --pull -> docker compose up -d
PLUGIN_CHATBOT_REF=b76e29dff6dc3ef8352b9f440aeaff1bdb8e5627

# pip 源。国内建议换镜像，例如：
#   https://mirrors.tencent.com/pypi/simple
#   https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple

# 管理控制台的绑定地址。
#   127.0.0.1 = 只有本机能访问（推荐，配合 SSH 隧道）
#   0.0.0.0   = 对外暴露（务必套 HTTPS 反向代理并设强 BRIDGE_CONSOLE_TOKEN）
BOT_BIND=127.0.0.1
BOT_PORT=8080

TZ=Asia/Shanghai
